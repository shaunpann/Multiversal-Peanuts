# XRPL testnet (Devnet also works: wss://s.devnet.rippletest.net:51233)
XRPL_ENDPOINT=wss://s.altnet.rippletest.net:51233

# Total escrowed on-ledger for the demo, in XRP.
# Represents the S$30,000 contract at demo scale (1 XRP = S$5,000).
DEAL_XRP=6

# Optional. With a key the buyer/supplier agents negotiate with Claude.
# Without one they fall back to a deterministic negotiation (demo still runs).
ANTHROPIC_API_KEY=

PORT=3000
