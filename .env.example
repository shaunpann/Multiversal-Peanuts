# Port the web app listens on.
PORT=3000

# Refund deadline on every escrow: if the verification agent never releases,
# the buyer reclaims the funds after this many seconds without needing the
# supplier's or the oracle's cooperation. Shorten it to demo the refund path.
CANCEL_AFTER_SECONDS=604800

# Optional. With a key, claude-opus-5 reads the buyer's WhatsApp/email thread
# into a brief and vision judges delivery photos. Without one, both fall back
# to clearly-labelled non-AI checks and the app still runs end to end.
ANTHROPIC_API_KEY=
